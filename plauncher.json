{
  "schema_version": 1,
  "id": "antigravity-sync",
  "name": "Antigravity Sync",
  "description": "Synchroniseer en start je Antigravity-data en configuratie.",
  "architecture": "x86_64",
  "channel": "stable",
  "icon_path": "assets/AntigravitySync.png",
  "installer": {
    "kind": "sync_custom",
    "uninstall_key": "AntigravitySync",
    "asset_pattern": "AntigravitySync-Setup-v{version}.exe",
