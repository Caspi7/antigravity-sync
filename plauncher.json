  },
  "executable": {
    "file_name": "AntigravitySync.exe",
    "registry_key": "Software\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\AntigravitySync",
    "install_dir_value": "InstallLocation"
  }
}